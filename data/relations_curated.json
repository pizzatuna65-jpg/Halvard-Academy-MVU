  }
 },
 "group_rules": {
  "_note": "1.4.2 (owner): a view of a whole group becomes one-way lines to every member once the field that states it is unlocked (the field's own rank). 'from': one NPC or '*' (everyone with that field); 'field': the dossier field; 'match': {regex on the field text: line type}, first match wins (none = no lines, e.g. Neutral); 'to': 'mages' (every NPC with a Magic field) or 'faction:<id>' (data/factions.json members). A hand-curated line between the same two people wins. Rule lines are drawn only to people you have met, and the dossier lists them as one row.",
  "rules": [
   {
    "id": "caine_mages",
    "label": "Mages",
    "from": "Caine",
    "field": "Hates",
    "match": {
     "\\bMages\\b": "dislike"
    },
    "to": "mages"
   },
   {
    "id": "doves",
    "label": "The Dovecote",
    "from": "*",
    "field": "Doves",
    "match": {
     "^Hates": "dislike",
     "^Admires": "respect"
    },
    "to": "faction:doves"
   }
  ]
 },
 "romance_one_way": {
  "_note": "1.4.2 (owner): NPCs who love {{user}} one way. Once it is out (field: that dossier field is unlocked; secret: a regex on the topic of one of their Secrets_revealed entries), People -> Connections draws a Romance arrow from them to {{user}}, until {{user}} starts a romance with them (Bonds.<id>.Romance, Rank 8 by default); then the shared romance line replaces it.",
  "Etnie": {
   "field": "Loves",
   "note": "Loves you above everything, and is wholly convinced she is your big sister."
  },
  "Kanae": {
   "secret": "plan|love|goal|feeling|obsess|reading|true",
   "note": "Loves you, and has planned for a long time to keep you for herself."
  }
 }
