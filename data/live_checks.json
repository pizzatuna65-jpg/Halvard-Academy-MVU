{
 "version": 1,
 "card": "1.99.14",
 "note": "Live-check rules for the Black Box quest autopilot (docs/BUILD.md 'Live check rules'). Each rule's quest + line names one check in docs/TEST_CHECKLIST.md; whole: the rule covers the whole check (else quest_ticks.py only notes the machine part); the card carries this file in data.extensions.eldrasil_live_checks (0 prompt tokens).",
 "checks": [
  {"id": "q0.2-now-lines", "quest": "Q0.2", "line": "The first reply may lack some `<now>` lines", "skip": 1, "needs": 3, "when": {"state": "World.Location", "exists": true}, "pass": {"block": "now", "match": "^Walks from here"}, "whole": true},
  {"id": "q0.2-folds", "quest": "Q0.2", "line": "The narrator writes the folds and the gist", "mode": "review", "when": {"block": "rule_cards", "match": "(?i)\\bfold"}},
  {"id": "q0.2-no-engine-error", "quest": "Q0.2", "line": "No \"Engine error\" line in the Log", "needs": 10, "max": 1000, "pass": {"signals": "engineError", "eq": false}},
  {"id": "q0.2-prompt", "quest": "Q0.2", "line": "Prompt: the chat older than about 24 messages", "needs": 3, "when": {"record": "mesId", "gt": 30}, "pass": {"all": [{"prompt": {"match": "\\[… \\d+ earlier messages"}}, {"prompt": {"not": "<%"}}, {"block": "variable_update_rules", "exists": true}, {"block": "update_format", "exists": true}]}},
  {"id": "q0.2-prompt-end", "quest": "Q0.2", "line": "Prompt, the end: after your message one assistant", "needs": 3, "pass": {"all": [{"prompt": {"match": "<input_authority>[\\s\\S]*<card_fidelity>"}}, {"any": [{"block": "final_cast_gate", "exists": false}, {"prompt": {"match": "<card_fidelity>[\\s\\S]*<final_cast_gate>"}}]}]}},
  {"id": "q0.3-no-tracker-blocks", "quest": "Q0.3", "line": "No reply holds an Internal States, FATE & ROUTINE", "needs": 10, "max": 1000, "pass": {"reply": {"not": "(?i)Internal States|FATE & ROUTINE|GM'?s Notebook|<(gold|red|blue|green|purple|cyan|pink|orange)>"}}},
  {"id": "q0.3-air-carried", "quest": "Q0.3", "line": "Smells are rare: only food at a meal", "needs": 10, "max": 1000, "pass": {"prose": {"not": "(?i)\\bthe air (?:carried|was thick with|smelled|smelt|held the (?:smell|scent))"}}},
  {"id": "q0.3-no-refusal", "quest": "Q0.3", "line": "No reply is blocked or refused by Gemini", "needs": 10, "max": 1000, "pass": {"prose": {"not": "(?i)I can(?:not|'t) (?:continue|help with|write) (?:this|that)|as an AI\\b"}}, "whole": true},
  {"id": "q0.3-no-400", "quest": "Q0.3", "line": "No error 400 \"Requests ending with a model turn\"", "needs": 10, "max": 1000, "pass": {"record": "status", "ne": 400}, "whole": true},
  {"id": "q0.3-not-empty", "quest": "Q0.3", "line": "No empty or cut-off replies", "needs": 10, "max": 1000, "pass": {"all": [{"record": "complete", "eq": true}, {"prose": {"match": "\\S", "count": {"min": 200}}}]}, "whole": true},
  {"id": "q1.1-event-line", "quest": "Q1.1", "line": "`<now>` has \"Event: Entrance Event. Now: … Next:", "needs": 2, "when": {"all": [{"state": "World._Event_today", "match": "Entrance Event"}, {"state": "World.Time", "match": "^(1[0-7]):"}]}, "pass": {"block": "now", "match": "Event: Entrance Event[^\\n]*\\. Now: [^\\n]+\\. Next: "}},
  {"id": "q1.1-info-layers", "quest": "Q1.1", "line": "Info layers: an open person (Trixie, Ruby)", "mode": "review", "when": {"any": [{"present": "Trixie"}, {"present": "Ruby"}, {"present": "Kanae"}, {"present": "Irene"}]}},
  {"id": "q1.1-loves-dodge", "quest": "Q1.1", "line": "At Rank 0 ask Trixie and Caralynn what they love", "mode": "review", "when": {"all": [{"any": [{"present": "Trixie"}, {"present": "Caralynn"}]}, {"user": {"match": "(?i)\\b(love|loves|favou?rite|like best)\\b"}}]}},
  {"id": "q1.1-birthday", "quest": "Q1.1", "line": "Ask someone their birthday", "mode": "review", "when": {"user": {"match": "(?i)birthday"}}},
  {"id": "q1.1-who-is-here", "quest": "Q1.1", "line": "Who is here: the reply that arrives at a new place", "mode": "review", "when": {"block": "now", "match": "^Here now at "}},
  {"id": "q1.1-look-for", "quest": "Q1.1", "line": "Look for: Activities → Action has \"Look for someone\"", "when": {"user": {"match": "(?i)I'?m looking for "}}, "pass": {"block": "now", "match": "Looking for .+ \\(the engine's roll\\): "}},
  {"id": "q1.1-thoughts-present", "quest": "Q1.1", "line": "Someone not yet named shows their role", "mode": "review", "when": {"reply": {"match": "<npc_thoughts>"}}},
  {"id": "q1.1-tour-line", "quest": "Q1.1", "line": "`<now>` has the \"Entrance tour assignment", "needs": 2, "when": {"all": [{"state": "World._Event_today", "match": "Entrance Event"}, {"state": "World.Time", "match": "^(1[0-7]):"}]}, "pass": {"all": [{"block": "now", "match": "Entrance tour assignment \\(keep these same people through 18:00\\)"}, {"block": "campus_rules", "match": "Entrance"}]}},
  {"id": "q1.1-tour-gone", "quest": "Q1.1", "line": "`<now>` has the \"Entrance tour assignment", "when": {"all": [{"state": "World.Month", "eq": 1}, {"state": "World.Week", "eq": 1}, {"state": "World.Day", "eq": "Tue"}]}, "pass": {"block": "now", "not": "Entrance tour assignment"}},
  {"id": "q1.1-clear-sky", "quest": "Q1.1", "line": "A clear sky all day (an event day)", "needs": 3, "when": {"state": "World._Event_today", "match": "Entrance Event"}, "pass": {"state": "World._Weather", "not": "(?i)rain|storm|drizzle|snow|hail|fog|overcast"}},
  {"id": "q1.1-ambience", "quest": "Q1.1", "line": "Each arrival: an Ambience line in `<now>`", "mode": "review", "when": {"block": "now", "match": "^Ambience at "}},
  {"id": "q1.1-likely-walks-nowwith", "quest": "Q1.1", "line": "`<now>` has \"Likely around …\" and \"Walks from here", "needs": 3, "when": {"block": "cast", "exists": true}, "pass": {"all": [{"block": "now", "match": "^(?:Likely around|Here now at|Presence: |With [^\\n(]*\\(outside the roll)"}, {"block": "now", "match": "^Walks from here"}, {"block": "cast", "match": "Now with [^,\\n]+, \\S"}]}},
  {"id": "q1.1-say-tags", "quest": "Q1.1", "line": "Dialogue colours: Kanae and Zara each speak", "needs": 2, "when": {"all": [{"present": "Kanae"}, {"prose": {"match": "Kanae"}}]}, "pass": {"reply": {"match": "<say:Kanae[:>]"}}},
  {"id": "q1.1-not-x-but-y", "quest": "Q1.1", "line": "Prose (preset): Charles's action and words", "needs": 10, "max": 200, "pass": {"prose": {"not": "(?i)\\bIt wasn't [^.!?\\n]{1,60}[.!] It was\\b|\\bnot (?:a |an |the )?\\w+(?: \\w+)?, but (?:a |an |the )?\\w+"}}},
  {"id": "q1.1-carries", "quest": "Q1.1", "line": "What people carry comes up when the scene uses it", "needs": 2, "when": {"all": [{"block": "cast", "exists": true}, {"any": [{"present": "Zara"}, {"present": "Kanae"}]}]}, "pass": {"block": "cast", "match": "Carries \\(shown when the scene calls for it\\): "}},
  {"id": "q1.1-scene-marker", "quest": "Q1.1", "line": "Prompt: `<latest_input>` (Player Input Authority)", "needs": 10, "max": 1000, "pass": {"prose": {"not": "\\(scene:"}}, "whole": true},
  {"id": "q1.1-interactions-card", "quest": "Q1.1", "line": "With Kanae and Zara here the Prompt's 502 says", "needs": 2, "when": {"any": [{"present": "Kanae"}, {"present": "Zara"}]}, "pass": {"all": [{"block": "variable_update_rules", "match": "Interactions:[^\\n]*the full rule is in <rule_cards> now"}, {"block": "rule_cards", "match": "Interactions"}]}},
  {"id": "q1.1-optional-threads", "quest": "Q1.1", "line": "`<now>` ends its optional lines with \"Optional threads", "needs": 3, "when": {"block": "now", "match": "^Likely around "}, "pass": {"block": "now", "match": "^Optional threads \\([^)]*\\): use at most one"}},
  {"id": "q1.1-no-beats", "quest": "Q1.1", "line": "Kanae, Zara and whoever else is here act", "needs": 10, "max": 1000, "pass": {"prose": {"not": "(?i)(?:^|[.!?\"”] )A (?:beat|pause)\\."}}},
  {"id": "q1.1-mentioned", "quest": "Q1.1", "line": "Someone only talked about (the Headmaster", "mode": "review", "evidence": 2, "when": {"prompt": {"match": "Only mentioned, not here"}}},
  {"id": "q1.1-cast-clean", "quest": "Q1.1", "line": "`<cast>` holds exactly the people present", "needs": 3, "when": {"block": "cast", "exists": true}, "pass": {"block": "cast", "not": "^@@"}},
  {"id": "q1.1-no-cast-alone", "quest": "Q1.1", "line": "`<cast>` holds exactly the people present", "when": {"state": "Scene.Present", "eq": {}}, "pass": {"all": [{"block": "cast", "exists": false}, {"block": "final_cast_gate", "exists": false}]}},
  {"id": "q1.3-chance-done", "quest": "Q1.3", "line": "After 45 minutes at the feast", "eventually": true, "when": {"all": [{"state": "World._Event_today", "match": "Entrance Event"}, {"state": "World.Location", "match": "Ring Dining Hall"}]}, "pass": {"signals": "log", "match": "Event chance done: Be at the Entrance Feast"}},
  {"id": "q1.3-speeches", "quest": "Q1.3", "line": "The Headmaster and Vice Headmaster speak", "mode": "review", "evidence": 2, "when": {"all": [{"state": "World._Event_today", "match": "Entrance Event"}, {"state": "World.Location", "match": "Ring Dining Hall"}]}},
  {"id": "q1.3-no-curfew", "quest": "Q1.3", "line": "Past 20:00 `<now>` shows no curfew until 22:00", "when": {"all": [{"state": "World._Event_today", "match": "Entrance Event"}, {"state": "World.Time", "match": "^2[01]:"}]}, "pass": {"state": "World._Curfew", "not": "CURFEW \\(20:00"}},
  {"id": "q1.4-curfew-risk", "quest": "Q1.4", "line": "Out of the dorm after 22:00", "when": {"all": [{"state": "World.Time", "match": "^2[23]:"}, {"state": "World.Location", "not": "(?i)Dormitory"}]}, "pass": {"block": "now", "match": "Curfew: CURFEW"}},
  {"id": "q1.4-fortune-unnamed", "quest": "Q1.4", "line": "Slipping past a patrol is settled by the Fortune", "needs": 10, "max": 1000, "pass": {"prose": {"not": "(?i)\\bfortune (?:number|roll)\\b|\\brolled (?:a )?\\d+\\b"}}},
  {"id": "q1.4-three-numbers", "quest": "Q1.4", "line": "Two risky attempts in one reply", "needs": 3, "when": {"block": "now", "match": "^Fortune \\("}, "pass": {"block": "now", "match": "^Fortune \\([^)]*\\): \\d+, then \\d+, then \\d+"}},
  {"id": "q1.4-uncanny", "quest": "Q1.4", "line": "By the lake or another story's place after dark", "mode": "review", "evidence": 2, "when": {"block": "now", "match": "^Uncanny \\("}},
  {"id": "q1.4-tilly-ghosts", "quest": "Q1.4", "line": "Ask Tilly about the Night Swimmer", "mode": "review", "evidence": 2, "when": {"all": [{"present": "Tilly"}, {"user": {"match": "(?i)night swimmer|polite walker"}}]}},
  {"id": "q1.5-slept", "quest": "Q1.5", "line": "In the dorm, ask to skip to the morning", "eventually": true, "when": {"all": [{"state": "World.Location", "match": "(?i)Dormitory"}, {"before": "World.Time", "match": "^(2[0-3]|0[0-4]):"}, {"state": "World.Time", "match": "^(0[5-9]|1[01]):"}]}, "pass": {"signals": "log", "match": "slept through the night|Resting"}},
  {"id": "q1.5-midnight", "quest": "Q1.5", "line": "Across midnight the update writes only Day and Time", "when": {"all": [{"before": "World.Time", "match": "^2[0-3]:"}, {"state": "World.Time", "match": "^0\\d:"}]}, "pass": {"reply": {"not": "\"path\"\\s*:\\s*\"/World/(?:Week|Month)\""}}, "whole": true},
  {"id": "q2.1-morning", "quest": "Q2.1", "line": "07:30 the bracelet reads \"Morning, before classes\"", "when": {"all": [{"state": "World.Month", "eq": 1}, {"state": "World.Week", "eq": 1}, {"state": "World.Day", "eq": "Tue"}, {"state": "World.Time", "match": "^07:"}]}, "pass": {"state": "World._Period", "eq": "Morning, before classes"}},
  {"id": "q2.1-teachers", "quest": "Q2.1", "line": "A teacher keeps their Cast Sheet voice", "mode": "review", "when": {"any": [{"present": "Hester"}, {"present": "Anselm"}, {"present": "Magnus"}, {"present": "Dorian"}, {"present": "Cedric"}, {"present": "Anya"}, {"present": "Kotaro"}, {"present": "Valentin"}]}},
  {"id": "q2.2-purchases", "quest": "Q2.2", "line": "Buy a bakery roll to eat now and a notebook", "mode": "review", "when": {"reply": {"match": "/Purchases"}}},
  {"id": "q2.2-stray-inventory", "quest": "Q2.2", "line": "Someone gives Charles something small", "when": {"reply": {"match": "/Player/Inventory"}}, "pass": {"signals": "log", "match": "(?i)\\bmoved\\b"}},
  {"id": "q2.3-not-charged", "quest": "Q2.3", "line": "Write \"I cast Lightning Arc\" and let the update miss it", "when": {"block": "now", "match": "appears in the last exchange but was not charged"}, "pass": {"block": "now", "match": "appears in the last exchange but was not charged"}},
  {"id": "q2.4-combat-role", "quest": "Q2.4", "line": "The five role teachers (Gavlan", "eventually": true, "when": {"all": [{"state": "World.Month", "eq": 1}, {"state": "World.Week", "eq": 1}, {"state": "World.Day", "in": ["Thu", "Fri", "Sat", "Sun"]}]}, "pass": {"state": "Player.Profile.Combat_role", "match": "\\S"}},
  {"id": "q2.5-walk-log", "quest": "Q2.5", "line": "One short reply from the Canteen to the Boathouse", "eventually": true, "when": {"all": [{"state": "World.Location", "match": "Boathouse"}, {"before": "World.Location", "match": "Canteen"}]}, "pass": {"signals": "log", "match": "^Walked .+ min on foot"}},
  {"id": "q2.6-leave", "quest": "Q2.6", "line": "More people around Charles on an ordinary day", "mode": "review", "evidence": 2, "when": {"block": "now", "match": "takes their leave in this reply"}},
  {"id": "q2.7-sunday", "quest": "Q2.7", "line": "Sunday 07:30: \"Sunday (no classes)\"", "when": {"all": [{"state": "World.Time", "match": "^07:"}, {"state": "World.Day", "eq": "Sun"}]}, "pass": {"state": "World._Period", "eq": "Sunday (no classes)"}, "whole": true},
  {"id": "q2.7-bake", "quest": "Q2.7", "line": "Saturday 15:00–17:00 in the Canteen", "when": {"all": [{"state": "World.Day", "eq": "Sat"}, {"state": "World.Location", "match": "Canteen"}, {"state": "World.Time", "match": "^1[56]:"}]}, "pass": {"block": "now", "match": "Cooking Club"}},
  {"id": "q2.7-client", "quest": "Q2.7", "line": "In a service club (Tailoring, Smithing, Fishing", "mode": "review", "evidence": 2, "when": {"block": "now", "match": "^Club client: "}},
  {"id": "q2.7-alcohol", "quest": "Q2.7", "line": "On a Sunday (students may drink only on Sundays", "when": {"all": [{"state": "World.Day", "eq": "Sun"}, {"user": {"match": "(?i)\\b(drink|drinks|ale|beer|wine|Barrow & Vine)\\b"}}]}, "pass": {"prompt": {"match": "Students may buy alcohol and tobacco"}}, "whole": true},
  {"id": "sqcache-cached", "quest": "SQ-CACHE", "line": "Cached tokens per request from the second reply on", "skip": 1, "needs": 3, "pass": {"record": "usage.cachedInputTokens", "gt": 15000}},
  {"id": "sqcache-blackbox", "quest": "SQ-CACHE", "line": "Instead of OpenRouter's Activity page", "needs": 3, "pass": {"all": [{"record": "usage.inputTokens", "gt": 0}, {"record": "usage.cachedInputTokens", "exists": true}, {"record": "cost", "exists": true}]}, "whole": true},
  {"id": "sqbb-background", "quest": "SQ-BB", "line": "Wand → Black Box lists every reply", "scope": "any", "when": {"record": "kind", "eq": "background"}, "pass": {"record": "genType", "eq": "quiet"}},
  {"id": "sqbb-engine", "quest": "SQ-BB", "line": "Engine fills a second or two after the reply", "needs": 3, "pass": {"all": [{"signals": "eldrasil", "eq": true}, {"signals": "floor", "exists": true}]}},
  {"id": "sqsc-snippets", "quest": "SQ-SC", "line": "Snippet Browser after the first three batches", "needs": 2, "when": {"block": "story_before_chat", "exists": true}, "pass": {"block": "story_before_chat", "match": "\\[Y\\d M\\d+ W\\d \\w+ \\d\\d:\\d\\d"}},
  {"id": "sqsc-past", "quest": "SQ-SC", "line": "*Prompt*: the `<story_before_chat>` block", "mode": "review", "evidence": 2, "when": {"block": "story_before_chat", "exists": true}},
  {"id": "sqw-demons", "quest": "SQ-W", "line": "Ask in History Class (or a teacher) about the demons", "mode": "review", "evidence": 2, "when": {"user": {"match": "(?i)\\bdemons?\\b|the Crack|\\bGates?\\b"}}},
  {"id": "sqw-gavlan", "quest": "SQ-W", "line": "Ask Gavlan about the World Competition", "mode": "review", "evidence": 2, "when": {"all": [{"present": "Gavlan"}, {"user": {"match": "(?i)world competition"}}]}},
  {"id": "sqw-aces", "quest": "SQ-W", "line": "Name a World ace in talk", "mode": "review", "evidence": 2, "when": {"user": {"match": "Hibiki|Lucrezia|Kamran|Cyprien"}}},
  {"id": "sqw-aces-away", "quest": "SQ-W", "line": "Name a World ace in talk", "when": {"user": {"match": "Hibiki|Lucrezia|Kamran|Cyprien"}}, "pass": {"none": [{"present": "Hibiki"}, {"present": "Lucrezia"}, {"present": "Kamran"}, {"present": "Cyprien"}]}},
  {"id": "sqd-secret", "quest": "SQ-D", "line": "Charles breaks a rule the Doves would act on", "when": {"reply": {"match": "/Hidden/Secrets/"}}, "pass": {"state": "Hidden.Secrets", "ne": {}}},
  {"id": "sqm-investigate", "quest": "SQ-M", "line": "At a place where an open thread's clue was seen", "mode": "review", "evidence": 2, "when": {"block": "now", "match": "^Investigate here "}},
  {"id": "sqh-ward", "quest": "SQ-H", "line": "Charles hurt: a stay in the Medical Centre", "mode": "review", "evidence": 2, "when": {"state": "World.Location", "match": "Medical Centre"}},
  {"id": "sq1-ooc-clock", "quest": "SQ1", "line": "An OOC question to the narrator", "when": {"user": {"match": "(?i)^\\s*[(\\[]?\\s*OOC\\b"}}, "pass": {"state": "World.Time", "unchanged": true}},
  {"id": "sq1-rule-cards-mail", "quest": "SQ1", "line": "In one-call mode (the default since 1.69)", "when": {"state": "World.Location", "match": "Mail Tower"}, "pass": {"prompt": {"match": "<rule_cards>[\\s\\S]*?[Ll]etter[\\s\\S]*?</rule_cards>[\\s\\S]*<now>"}}}
 ]
