<%_
// Source of custom entry 509, the head of the Cast Sheet (1.5.1 Batch B; 1.48.0 audit 2.7: the sheets are one entry per NPC, uid 600+,
// and 509_tail.template.ejs closes it). tools/gen_mvu_entries.py fills CAST; edit this file, not 509.txt.
const CS = getvar('stat_data.$ui.cast') || {}, FULL = CS.full || [], BRIEF = CS.brief || [];
const CX = getvar('stat_data.Extras') || {}, XHERE = (CS.extras || []).filter(x => CX[x]), XNEW = CS.xnew || [];
const CD = /*@@CAST@@*/{};
const HERE = [...FULL, ...BRIEF];
// 1.11.0 (token audit A8): what every sheet shares is said once, and only what the people here need
const CHEAD = (() => {
  const out = [], types = [...new Set(HERE.map(id => (CD.change || {})[id]).filter(Boolean))];
  const DEF = { fixed: 'fixed = experience deepens who they are, never rewrites them', shaped: 'shaped = a major, repeated experience can change one part of them for good, the old self still showing under stress', fluid: 'fluid = they change with their surroundings over months, never within one scene' };
  if (FULL.some(id => (CD.npcs[id] || {}).secret)) out.push('<narrator_only> parts are for you alone; the character never states them, and they show only as hints and tells.');
  if (FULL.some(id => (CD.voice || {})[id])) out.push('Voice examples show situations, never lines to repeat.');
  if (types.length) out.push('Change: ' + types.map(t => DEF[t]).join('; ') + '.');
  return out.length ? 'On these sheets: ' + out.join(' ') : '';
})();
_%>
<%_ if (HERE.length || XHERE.length || XNEW.length) { _%>
<cast>
Character sheets for the people present: the truth about each of them. They outrank the lorebook text and anything earlier in the chat. Rank, Trust and Tension change how a character treats {{user}}, never who they are.
<%_ if (CHEAD) { _%>
<%- CHEAD %>
<%_ } _%>
<%_ } _%>
