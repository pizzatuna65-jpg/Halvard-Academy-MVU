<%_
// Source of custom entry 505 (Now). tools/gen_mvu_entries.py fills the /*@@…@@*/ data and writes content/505.txt. Edit this file, not 505.txt.
const W = getvar('stat_data.World') || {};
const H = getvar('stat_data.Hidden') || {};
const UI = getvar('stat_data.$ui') || {};
const PR = getvar('stat_data.Player.Profile') || {};
const OFF = UI.off || [];
const on = id => (id === 'happenings' ? UI.happenings !== 'off' : id === 'weather' ? (UI.wxfx || 'full') !== 'off' : !OFF.includes(id));
const WX = on('weather') && UI.wx && !UI.wx.away && UI.wx.now ? UI.wx : null;
const FULL = !!WX && WX.mode === 'full';
const REG = /*@@REG@@*/{};
const place = String(W.Location || '').split(/\s+[—-]\s+/)[0].trim();
const pk = place.toLowerCase().replace(/^the /, '');
const regs0 = REG[place.toLowerCase()] || REG[pk] || [];
const NST = getvar('stat_data.Campus_State.NPC_status') || {};
const stOf = r => { const k = Object.keys(NST).find(x => x.toLowerCase() === r.toLowerCase() || x.toLowerCase().split(/\s+/)[0] === r.toLowerCase()); return k ? NST[k] : ''; };
const GRAD = getvar('stat_data.Campus_State.Graduated') || [], ARR = /*@@ARR@@*/{};
const Y = Math.max(1, Number(W.Year) || 1);
const here = r => !GRAD.includes(r) && (ARR[r] || 1) <= Y;   // 1.0.3: graduates left; incoming first-years not here yet
// 1.1.0: class-aware presence (spec §1), weather and flu (spec §4.8)
const STU = /*@@STU@@*/{}, TEACH = /*@@TEACH@@*/{};
const TT = /*@@TT@@*/{};
const CLUBV = /*@@CLUBV@@*/{}, OUTD = /*@@OUTD@@*/[], VN = /*@@VN@@*/{};
const MOODS = /*@@MOODS@@*/[];
const sick = FULL && WX.flu ? (WX.sick || []) : [];
let regs1 = regs0.filter(r => here(r) && !sick.includes(r));
const per = /^P([123]) /.exec(String(W._Period || '')), pIdx = per ? +per[1] - 1 : -1;
const cls = on('class') && pIdx >= 0 && TT[W.Day] ? TT[W.Day][pIdx] : null;   // [subject, M|D, venues, class|study|clubs]
const until = ['10:00', '12:00', '16:00'][pIdx];
const pres = [];
let clubs = [];
if (cls && cls[3] === 'class') {
  const atVenue = cls[2].includes(pk), teaching = r => (TEACH[r] || []).some(x => x[0] === cls[0]);
  regs1 = regs1.filter(r => !STU[r] && (atVenue || !teaching(r)));
  pres.push('Students are in class until ' + until + '.');
} else if (cls && cls[3] === 'study') {
  if (cls[2].includes(pk)) pres.push('Study Hall until 12:00: most students are here.');
  else { regs1 = regs1.filter(r => !STU[r]); pres.push('Students are at Study Hall in the Main Library until 12:00.'); }
} else if (cls) {
  regs1 = regs1.filter(r => !STU[r]);
  clubs = CLUBV[pk] || [];
  if (!clubs.length) pres.push('Students are at their clubs until 16:00.');
}
const bad = FULL && (WX.now.sky === 'Rain' || WX.now.sky === 'Storm');
let moved = [];
if (bad && OUTD.includes(pk) && !((pk === 'boathouse and lake' || pk === 'fishing house') && WX.now.sky === 'Rain')) { moved = regs1; regs1 = []; }   // the Fishing Club likes rain
const clubLine = clubs.map(c => {
  const m = c[1].filter(id => here(id) && !sick.includes(id) && !stOf(id));
  return c[0] + (bad && c[2] && !c[3] ? ': practising indoors (Gymnasium) or cancelled in this weather' : ': meeting here until 16:00' + (m.length ? ' (members on record: ' + m.join(', ') + ')' : ''));
}).join('; ');
let classLine = '';
if (cls && cls[3] === 'class' && cls[2].includes(pk)) {
  const PY = Math.max(1, Math.min(3, Number(PR.Year) || 1)), dorm = PR.Dorm || 'Unsorted';
  const tch = Object.keys(TEACH).find(id => TEACH[id].some(x => x[0] === cls[0] && (x[1] === PY || x[1] === 0)) && !stOf(id));
  const mates = Object.keys(STU).filter(id => here(id) && STU[id][0] + Y - STU[id][1] === PY && !sick.includes(id) && !stOf(id)
    && (cls[1] !== 'D' || dorm === 'Unsorted' || STU[id][2] === dorm)).slice(0, 8);
  classLine = 'Your class now: ' + cls[0] + ' [' + cls[1] + '] (Year ' + PY + ', ' + (cls[1] === 'D' ? (dorm === 'Unsorted' ? 'dorm not yet sorted' : dorm + ' only') : 'all dorms')
    + ') at ' + (VN[pk] || place) + ' — teacher ' + (tch || 'not on record') + '; classmates on record: ' + (mates.join(', ') || 'none');
}
const regs = regs1.filter(r => !stOf(r)), regSt = regs1.filter(r => stOf(r));
const cur = String(W._Curfew || '');
const due = on('planner') ? Object.entries(getvar('stat_data.Commitments') || {}).filter(([k, c]) => c && (c._Late || /^(today|tomorrow)/.test(String(c._When || '')))) : [];
const mail = on('letters') ? Object.values(getvar('stat_data.Letters') || {}).filter(l => l && l.Status === 'waiting').length : 0;
const HK = on('hooks') ? Object.entries(getvar('stat_data.Hooks') || {}).filter(([k, h]) => h) : [];
const hDue = HK.filter(([k, h]) => h._State === 'due' || h._State === 'overdue'), hOld = HK.filter(([k, h]) => h._State === 'old' && h.Weight >= 2);
const GS = on('gossip') ? (UI.gossip || []).slice(-5).reverse() : [];
const PRES = Object.keys(getvar('stat_data.Scene.Present') || {});
const moods = FULL ? MOODS.filter(m => PRES.includes(m.id)).map(m => (/cold|freezing/.test(WX.now.label) ? m.cold : WX.now.sky === 'Clear' && WX.block !== 2 && WX.now.temp >= 15 ? m.sunny : '')).filter(Boolean) : [];
const BT = getvar('stat_data.Battle') || {};
// 1.5.1 (P6): who spoke in the last reply without being in Scene.Present, and who was only mentioned (engine $ui.cast)
const CAST = UI.cast || {}, PRON = /*@@PRON@@*/{};
// 1.6.0 (N13): the age of dated lines in words; (N4) Next plans: met again, or may bring someone here now
/*@@AGE@@*/
const aged = w => { const a = ageOf(w, W); return a ? w + ', ' + a : w; };
const SINCE = UI.since || [], MAYBE = UI.maybe || [];
const JAGES = (getvar('stat_data.Journal') || []).slice(-5).reverse().map(l => (/^\[([^\]]+)\]/.exec(String(l)) || [])[1]).filter(w => w && ageOf(w, W));
// 1.2.2 bonds: for each present NPC, what they will talk about at this rank (openness shifts the early tiers; goals, views of others
// and the past need the real rank; secrets never come from rank) and what the bond allows; plus a ready bond event's directions
const BOND = /*@@BOND@@*/{};
const BONDS = getvar('stat_data.Bonds') || {}, BEVS = UI.bev || {};
const CLOSE = UI.close || [];   // 1.5.0 (N3a): bonds with XP at 80% or more of the next rank (engine)
// 1.4.3 Trust shifts what they share (Doubtful -1, Trusting +1, Confidant +2 and the real tiers one rank early; Betrayed: nothing
// new) and holds back the perks that need it (data/trust.json perk_gates)
const TRUST = /*@@TRUST@@*/{};
const SECR = [...(UI.secrets || []), ...((getvar('stat_data.Campus_State') || {}).Secrets_revealed || [])].map(x => String(x).toLowerCase());
const trBand = x => (TRUST.bands || [[0, '']]).reduce((a, [f, nm]) => (x >= f ? nm : a), '');
const trOver = id => { const o = (TRUST.overrides || {})[id]; return o && !(o.until_secret && SECR.some(x => x.startsWith(id.toLowerCase() + '.'))) ? o : null; };
const bondLines = PRES.filter(id => BONDS[id] && BOND.share).map(id => {
  const r = Math.max(0, Math.min(10, Number(BONDS[id].Rank) || 0)), tr = Math.max(0, Math.min(100, Number(BONDS[id].Trust) || 0)), tb = trBand(tr);
  const sh = (TRUST.share || {})[tb], early = tb === 'Confidant' ? TRUST.early || 0 : 0, o = (BOND.off[id] || 0) + (sh || 0);
  const ok = BOND.share.filter(([t]) => (t < BOND.real ? t <= Math.max(0, r + o) : t <= r + early));
  const next = BOND.share.find(([t]) => !ok.some(x => x[0] === t));
  const og = trOver(id), gated = og && og.no_gates ? [] : Object.entries(TRUST.gates || {}).filter(([g, need]) => +g <= r && +g !== 8 && tr < need && BOND.perks[g]).map(([g, need]) => BOND.perks[g] + ' (needs Trust ' + need + ')');
  const susp = (UI.tsusp || []).filter(k => ((getvar('stat_data._Perks') || {})[k] || {}).From === id);
  return id + ' (Rank ' + r + (BOND.tag[id] ? ', ' + BOND.tag[id] : '') + ', Trust ' + tr + ' ' + tb.toLowerCase() + (CLOSE.includes(id) ? ', close' : '') + '): '
    + (sh === null ? 'shares nothing new with {{user}}; keeps to what {{user}} already knows' : 'shares ' + ok.map(x => x[1]).join('; ')
    + (next ? '. Not yet: ' + next[1] + ' and beyond; asked about it, deflects in character (pushing too soon adds Tension)' : ''))
    + (r > 0 && BOND.perks[String(r)] ? '. At this rank: ' + BOND.perks[String(r)] : '')
    + (gated.length ? '. Held back by low Trust: ' + gated.join('; ') : '') + (susp.length ? '. Suspended until Trust ' + TRUST.susp + ': ' + susp.join(', ') : '') + '.';
});
// 1.4.3 how each present character carries their Trust: a personal rule (always), else only the telling bands
const trustLines = PRES.filter(id => BONDS[id]).map(id => {
  const og = trOver(id), dh = (TRUST.dorm_head || {})[id];
  const mine = dh && PR.Dorm === dh.dorm, cat = mine ? dh.category : (TRUST.npcs || {})[id] || 'normal', C = (TRUST.cats || {})[cat];
  const tr = Math.max(0, Math.min(100, Number(BONDS[id].Trust) || 0)), tb = trBand(tr);
  const parts = [og && og.text, mine && dh.text, C && C.bands[tb] ? id + ' (Trust ' + tr + ', ' + tb.toLowerCase() + '; ' + C.name.toLowerCase() + '): ' + C.bands[tb] + '. Never: ' + C.never + '.' : ''].filter(Boolean);
  return parts.join(' ');
}).filter(Boolean);
const bondEvents = Object.entries(BEVS).filter(([id, v]) => v && v.now && PRES.includes(id));
// 1.3.8 Tension: how each present character carries it (data/tension.json: category or personal override), from Friction (20) up
const TEN = /*@@TENSION@@*/{};
const tensionLines = PRES.filter(id => BONDS[id]).map(id => {
  const o = (TEN.overrides || {})[id], P = o || (TEN.categories || {})[(TEN.npcs || {})[id]];
  if (!P) return '';
  if (o && o.lock) return id + ': ' + o.text;
  const t = Math.max(0, Math.min(100, Number(BONDS[id].Tension) || 0));
  if (t < 20) return '';
  const band = (TEN.bands || []).reduce((a, [f, nm]) => (t >= f ? nm : a), '');
  const peak = band === 'Enemy' && (TEN.peaks || {})[id] ? ' (' + TEN.peaks[id] + ')' : '';
  const an = (TEN.apology_npc || {})[id];
  return id + ' (Tension ' + t + ', ' + band.toLowerCase() + '): ' + P.bands[band] + peak + '. Never: ' + P.never + '. Eases: ' + (an && an.note ? an.note : P.eases) + '.';
}).filter(Boolean);
// 1.4.4 (owner): each present character's latest moments with {{user}} (Bonds.<id>.$Recent, newest first) for consistency
const recentLines = PRES.filter(id => BONDS[id] && (BONDS[id].$Recent || []).length).map(id => id + ' (newest first): ' + BONDS[id].$Recent.slice(-(BOND.recent_now || 5)).reverse()
  .map(r => '[' + aged(r.w) + '] ' + r.n + (r.fx ? ' (' + r.fx + ')' : '')).join(' | '));
// 1.4.4 (owner): how each present character takes teasing and play-fighting (tension category or override: banter)
const banterLine = PRES.filter(id => BONDS[id]).map(id => { const o = (TEN.overrides || {})[id], P = (o && o.banter) ? o : (TEN.categories || {})[(TEN.npcs || {})[id]]; return P && P.banter ? id + ' ' + P.banter : ''; }).filter(Boolean).join('; ');
// 1.3.0 reputation: what each non-zero level means for how staff, students and the Doves treat {{user}}
const REPD = /*@@REP@@*/{};
const RPN = PR.Reputation || {};
const repLines = (REPD.reps || []).map(r => [r, Math.max(-5, Math.min(5, Number(RPN['_' + r]) || 0))]).filter(([, L]) => L)
  .map(([r, L]) => r + ' ' + (L > 0 ? '+' : '') + L + ': ' + ((REPD.effects[r] || []).find(([a, c]) => L >= a && L <= c) || [0, 0, ''])[2]);
_%>
<now>
Month <%- W.Month %>, Week <%- W.Week %>, <%- W.Day %> <%- W.Time %> | <%- W._Period || 'free time' %> | at <%- W.Location %>
<%_ if (W._Event_today) { _%>
Today: <%- W._Event_today %>
<%_ } _%>
<%_ if (cur) { _%>
Curfew: <%- cur %>
<%_ } _%>
<%_ if (W._Happening && on('happenings')) { _%>
Around campus today (optional, use only if it fits): <%- W._Happening %>
<%_ } _%>
<%_ if (/CURFEW|LOCKDOWN/.test(cur)) { _%>
Presence: after curfew students are in their own dorms; only staff, patrols and rule-breakers are out.
<%_ } else { _%>
<%_ if (pres.length) { _%>
<%- pres.join(' ') %>
<%_ } _%>
Likely around <%- place || 'here' %> (habits, not certainty; an established scene overrides): <%- regs.length ? regs.join(', ') : 'no regulars on record' %>
<%_ if (moved.length) { _%>
Moved indoors in this weather (Gymnasium, Common Rooms): <%- moved.join(', ') %>
<%_ } _%>
<%_ if (clubLine) { _%>
Club time: <%- clubLine %>
<%_ } _%>
<%_ if (regSt.length) { _%>
Regulars here with a status on record (it overrides their habits): <%- regSt.map(r => r + ': ' + stOf(r)).join('; ') %>
<%_ } _%>
<%_ if (classLine) { _%>
<%- classLine %>
<%_ } _%>
<%_ } _%>
<%_ if (FULL && WX.flu) { _%>
A cold is going around campus.<%- sick.length ? ' Off sick in their dorm today: ' + sick.join(', ') + '.' : '' %>
<%_ } _%>
<%_ for (const m of moods) { _%>
<%- m %>
<%_ } _%>
<%_ if (FULL && BT.Active && WX.field && on('battle')) { _%>
Battle field (outdoors): <%- WX.field %>.
<%_ } _%>
<%_ if (WX && WX.fc) { _%>
Divination Society forecast on the Notice Board for <%- WX.fc.tomorrow ? 'tomorrow' : 'today' %>: <%- WX.fc.blocks.map((b, i) => ['morning', 'afternoon', 'night'][i] + ' ' + b.text + ' (' + b.label + ')').join(', ') %>
<%_ } _%>
<%_ if (due.length) { _%>
Due soon: <%- due.map(([k, c]) => k + ' (' + (c._Late ? 'OVERDUE' : c._When) + (c.With ? ', with ' + c.With : '') + ')').join('; ') %>
<%_ } _%>
<%_ if (mail) { _%>
Mail Tower: <%- mail %> letter<%- mail > 1 ? 's' : '' %> waiting for {{user}} to collect.
<%_ } _%>
<%_ if (hDue.length) { _%>
Hooks due now: <%- hDue.map(([k, h]) => k + (h._State === 'overdue' ? ' (overdue)' : '') + ' (' + (h.Who ? h.Who + ': ' : '') + h.Note + ')').join('; ') %>
<%_ } _%>
<%_ if (hOld.length) { _%>
Old hooks (pay off or drop): <%- hOld.map(([k]) => k).join('; ') %>
<%_ } _%>
<%_ if (GS.length) { _%>
Rumours going around: <%- GS.map(g => '"' + g[0] + '" (' + g[1] + ', day ' + g[2] + ')').join('; ') %>
<%_ } _%>
<%_ for (const id of (CAST.gone || [])) { _%>
<%- id %> spoke in the last reply but is not in Scene.Present: add them if they are still here; otherwise they are gone and stay silent.
<%_ } _%>
<%_ if ((CAST.ment || []).length) { _%>
Mentioned, not here (they may not speak or act on-screen): <%- CAST.ment.map(id => id + ' (' + (PRON[id] || 'they/them') + ((CAST.where || {})[id] ? '; usually: ' + CAST.where[id] : '') + ')').join('; ') %>
<%_ } _%>
<%_ for (const [id, what, until] of SINCE) { _%>
Since you last saw <%- id %>: <%- what %><%- until ? ' (planned until ' + until + ')' : '' %>. Let it show in a small trace, never as a report.
<%_ } _%>
<%_ if (MAYBE.length) { _%>
May be here by their own plans (Next): <%- MAYBE.map(([id, what]) => id + ' (' + what + ')').join('; ') %>
<%_ } _%>
<%_ if (JAGES.length) { _%>
Journal dates, newest first: <%- JAGES.map(w => w + ' = ' + ageOf(w, W)).join('; ') %>
<%_ } _%>
<%_ for (const l of bondLines) { _%>
Bond: <%- l %>
<%_ } _%>
<%_ for (const l of tensionLines) { _%>
Tension: <%- l %>
<%_ } _%>
<%_ for (const l of trustLines) { _%>
Trust: <%- l %>
<%_ } _%>
<%_ for (const l of recentLines) { _%>
Recent with {{user}}: <%- l %>
<%_ } _%>
<%_ if (banterLine) { _%>
Teasing (how each present character takes it): <%- banterLine %>
<%_ } _%>
<%_ for (const [id, v] of bondEvents) { _%>
Bond event available with <%- id %> (Rank <%- v.r %> → <%- v.r + 1 %>): play it now if the scene allows it; never force it.
<%- v.dir %>
<%- v.s ? 'Follow these directions; lines marked Wajib / Must have to happen. ' : '' %>If the story has already changed what this event depends on (someone is hurt, away or told, or the place is closed), adapt it to the story as it is now; never replay it as if nothing happened. When it has played out: raise /Bonds/<%- id %>/Rank by 1, insert a line into its Milestones and add what {{user}} learned to Known_facts; the choices made may lower Trust (the engine adds Trust for the rank itself).
<%_ } _%>
<%_ for (const l of repLines) { _%>
Reputation, <%- l %>
<%_ } _%>
<%_ if (H._True_magic) { _%>
Hidden magic — Dove attention: <%- H._Stage %> (<%- H.Dove_attention %>/100)
<%_ } _%>
</now>
