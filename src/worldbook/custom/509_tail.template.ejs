<%_
// Source of custom entry 599, the end of the Cast Sheet (1.48.0 audit 2.7): who is tied to whom among the people here, the invented
// characters and </cast>. tools/gen_mvu_entries.py fills CAST; edit this file, not 599.txt.
const CS = getvar('stat_data.$ui.cast') || {}, HERE = [...(CS.full || []), ...(CS.brief || [])];
const CX = getvar('stat_data.Extras') || {}, XHERE = (CS.extras || []).filter(x => CX[x]);
const CD = /*@@CAST@@*/{};
const cExtra = x => { const r = CX[x]; return '[' + x + '] ' + r.Who + (r.Looks ? ' Looks: ' + r.Looks + '.' : '') + (r.Manner ? ' Manner: ' + r.Manner + '.' : '') + (r.Calls_user ? ' Calls {{user}} "' + r.Calls_user + '".' : '') + (r.Voice ? ' Voice: ' + r.Voice : ''); };
const pairs = [];
for (const a of HERE) for (const b of HERE) if (a !== b && (CD.rel[a] || {})[b]) pairs.push(a + ' → ' + b + ': ' + CD.rel[a][b]);
_%>
<%_ if (HERE.length || XHERE.length) { _%>
<%_ if (pairs.length) { _%>
Between the people here (the truth, whether or not {{user}} knows it):
<%_ for (const l of pairs) { _%>
- <%- l %>
<%_ } _%>
<%_ } _%>
<%_ if (XHERE.length) { _%>
Invented characters here (their Extras record is their card: the same look, manner and voice every time):
<%_ for (const x of XHERE) { _%>
- <%- cExtra(x) %>
<%_ } _%>
<%_ } _%>
</cast>
<%_ } _%>
